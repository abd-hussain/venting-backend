# Copy to .env for local development (alembic, uvicorn outside Docker)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=venting_db

SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Social auth — comma-separated allowlists for this environment (dev vs prod)
# GOOGLE_CLIENT_IDS=ios-client-id,android-client-id,web-client-id
# APPLE_AUDIENCES=com.vent.ventingMobileApp.dev,com.vent.ventingMobileApp.dev.signin

# Static / WebView / support (not API endpoints)
WEB_CONTENT_BASE_URL=https://venting-3a5ebaed4621.herokuapp.com
TERMS_URL=https://venting-3a5ebaed4621.herokuapp.com/legal/en/terms.html
PRIVACY_URL=https://venting-3a5ebaed4621.herokuapp.com/legal/en/privacy.html
HELP_CENTER_BASE_URL=https://venting-3a5ebaed4621.herokuapp.com/help
SUPPORT_EMAIL=support@venting.app
MAIL_FROM=noreply@venting.app
