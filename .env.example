# Copy to .env for local development (alembic, uvicorn outside Docker)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=venting_db

SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Static / WebView / support (not API endpoints)
TERMS_URL=https://venting.app/terms
PRIVACY_URL=https://venting.app/privacy
HELP_CENTER_BASE_URL=https://venting.app/help
SUPPORT_EMAIL=support@venting.app
# SUPPORT_WHATSAPP=https://wa.me/96170000000

# Or use a single URL instead of the fields above:
# DATABASE_URL=postgresql+psycopg://postgres:password123@localhost:5432/venting_db
